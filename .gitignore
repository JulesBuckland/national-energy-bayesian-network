# --- Data and outputs ---
# Leading slash matters: a bare "data/" also matches the src/data/ SOURCE
# package, which silently kept the entire population-synthesis stage out of
# the published repo. Anchor every data path to the repository root.
/data/
*.parquet
*.nc
*.pkl

# Generated output and logs, wherever they land. Left unanchored on purpose:
# running a module from the wrong working directory has previously scattered
# these into src/, and no source package is named logs/ or outputs/.
logs/
outputs/

# Stray data artefacts from exactly that mistake. src/data/ is a source
# package, so it cannot be excluded wholesale - name the artefact
# subdirectories explicitly instead.
src/data/raw/
src/data/processed/

# Test fixtures are derived from licensed inputs and are not redistributable.
# Spelled "tests/fixtures/*" rather than "tests/fixtures/" so the golden
# negation below can work: git cannot re-include anything inside a directory
# excluded by a plain "dir/" pattern, only inside one excluded via "dir/*".
tests/fixtures/*

# Golden-test baselines are the exception: they must be committed and persist
# across CI runs, or test_golden.py silently creates a fresh baseline every
# run instead of ever comparing against one.
!tests/fixtures/golden/
!tests/fixtures/golden/**

# --- Working notes and local tooling ---
# Research notes and planning documents stay local; OneDrive is their backup,
# not git. README.md is the one tracked markdown file. The directories below
# hold per-machine editor and tooling state.
*.md
!README.md
.claude/
.agents/
tasks/
meta/
scratch/
scratch_scripts/
.ignored/

# --- Private research material ---
/manuscript/
/applications/
/docs/
/papers/
/archive/
journal_resources/
literature/
github_submission/
methodology.txt

# --- Python ---
__pycache__/
*.pyc
.venv/
.env
.pytest_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# --- OS and misc ---
.DS_Store
Thumbs.db
.temp downloads/
python-installer.exe
